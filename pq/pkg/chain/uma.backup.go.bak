package chain

import (
	"context"
	"fmt"
	"math/big"

	"github.com/ethereum/go-ethereum"
	"github.com/ethereum/go-ethereum/common"
	"github.com/ethereum/go-ethereum/crypto"
	"github.com/ethereum/go-ethereum/ethclient"
)

var questionInitSig = crypto.Keccak256Hash(
	[]byte("QuestionInitialized(bytes32,uint256,address,bytes,address,uint256,uint256)"),
)

const chunkSize = 10000

type UmaClient struct {
	eth *ethclient.Client
}

func NewUmaClient(rpcURL string) (*UmaClient, error) {
	eth, err := ethclient.Dial(rpcURL)
	if err != nil {
		return nil, fmt.Errorf("rpc dial: %w", err)
	}
	return &UmaClient{eth: eth}, nil
}

func (u *UmaClient) Close() { u.eth.Close() }

// UmaLink finds the QuestionInitialized event for a market and returns the oracle.uma.xyz propose URL.
// adapter is the UmaCtfAdapter contract address (gamma.Market.ResolvedBy).
func (u *UmaClient) UmaLink(ctx context.Context, questionID, adapter string) (string, error) {
	if adapter == "" {
		return "", fmt.Errorf("adapter address required (use market.ResolvedBy)")
	}

	head, err := u.eth.BlockNumber(ctx)
	if err != nil {
		return "", fmt.Errorf("get block number: %w", err)
	}

	// Search last 30 days (~1.3M blocks)
	floor := head - 30*43200
	addr := common.HexToAddress(adapter)
	qID := common.HexToHash(questionID)

	for hi := head; hi > floor; {
		lo := hi - chunkSize
		if lo < floor {
			lo = floor
		}
		logs, err := u.eth.FilterLogs(ctx, ethereum.FilterQuery{
			Addresses: []common.Address{addr},
			Topics:    [][]common.Hash{{questionInitSig}, {qID}},
			FromBlock: new(big.Int).SetUint64(lo),
			ToBlock:   new(big.Int).SetUint64(hi),
		})
		if err != nil {
			return "", fmt.Errorf("filter logs [%d-%d]: %w", lo, hi, err)
		}
		if len(logs) > 0 {
			l := logs[0]
			return fmt.Sprintf(
				"https://oracle.uma.xyz/propose?project=Polymarket&transactionHash=%s&eventIndex=%d",
				l.TxHash.Hex(), l.Index,
			), nil
		}
		hi = lo
	}
	return "", fmt.Errorf("no QuestionInitialized event found for %s in last 30 days", questionID)
}
